# --- Local experiment directories: NOT for GitHub -------------------------
# Real runs against real scenes. They carry data paths, multi-GB zarr stores
# and machine-specific configuration, and they are the working record of what
# was measured rather than anything a user of this package needs. Kept in the
# working tree deliberately -- the analysis scripts and results live here and
# should not be lost -- but never pushed.
venezuela_six_scene_run/
venezuela_seven_scene_run/
venezuela_seven_scene_run_production/
geometry_calibration/
unstructured_session/
scratchpad_vz/
scratchpad/
workdir/

